# ============================================================
# Text-to-SQL GraphRAG Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=text2sql_dev

# --- LLM Provider ---
# Options: "ollama", "openai", "google"
LLM_PROVIDER=ollama

# --- Ollama (default — free, local) ---
# Install: https://ollama.com/download
# Then run: ollama pull llama3.1:8b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- OpenAI (optional) ---
# OPENAI_API_KEY=sk-...
# OPENAI_LLM_MODEL=gpt-4o
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Google Gemini (optional) ---
# GOOGLE_API_KEY=...
# GOOGLE_LLM_MODEL=gemini-1.5-flash
# GOOGLE_EMBED_MODEL=models/text-embedding-004

# --- SQL Generation ---
# Target SQL dialect: "postgres", "bigquery", "snowflake", "trino", "mysql"
SQL_DIALECT=postgres

# --- Embedding Dimensions ---
# Ollama nomic-embed-text: 768
# OpenAI text-embedding-3-small: 1536
# Google text-embedding-004: 768
EMBEDDING_DIMENSIONS=768

# --- dbt Docs Path ---
# Path to your dbt project's target/ directory
DBT_DOCS_PATH=./sample_dbt_docs

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
